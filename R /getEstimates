#' Estimate parameters for a trivariate Plackett copula
#'
#' Computes the parameter estimates of observed counts in a 3-dimensional binary
#' table under a trivariate Plackett copula model.
#'
#' @param counts numeric vector of length 8 with observed counts for all
#'   combinations of the three binary variables (n000, n001, ..., n111)
#' @param MLE logical indicating whether the MLEs should be used (or something more robust)
#'
#' @returns numeric vector of parameter estimates
#' @export
#'
#' @examples
#' counts <- c(n000=5, n001=3, n010=2, n011=1, n100=4, n101=2, n110=3, n111=6)
#' get.estimates(counts = counts, MLE = TRUE)

get.estimates <- function(counts, MLE = TRUE) {
  if (!is.matrix(counts)) {
    counts<-matrix(counts,1,8,dimnames=list("",names(counts)))
  }
  if (is.null(rownames(counts))) {rownames(counts)<-1:nrow(counts)}

  # Get counts in the same order as probs
  u <- rowSums(counts[,c("n100", "n101", "n110", "n111"), drop = F])/rowSums(counts)
  names(u)<-paste("u",rownames(counts))
  v <- rowSums(counts[,c("n010", "n011", "n110", "n111"), drop = F])/rowSums(counts)
  names(v)<-paste("v",rownames(counts))
  w <- rowSums(counts[,c("n001", "n101", "n011", "n111"), drop = F])/rowSums(counts)
  names(w)<-paste("w",rownames(counts))

  sums<-colSums(counts)
  # Add epsilon to regularize estimates to prevent zeros and infinities.
  e<-0.5*(1-MLE)

  params<-c((sums["n000"]+sums["n001"]+e)*(sums["n110"]+sums["n111"]+e)/(sums["n010"]+sums["n011"]+e)/(sums["n100"]+sums["n101"]+e),
    (sums["n000"]+sums["n010"]+e)*(sums["n101"]+sums["n111"]+e)/(sums["n001"]+sums["n011"]+e)/(sums["n100"]+sums["n110"]+e),
    (sums["n000"]+sums["n100"]+e)*(sums["n011"]+sums["n111"]+e)/(sums["n001"]+sums["n101"]+e)/(sums["n010"]+sums["n110"]+e),
    (sums["n111"]+e)*(sums["n100"]+e)*(sums["n010"]+e)*(sums["n001"]+e)/(sums["n000"]+e)/(sums["n011"]+e)/(sums["n101"]+e)/(sums["n110"]+e))
  names(params) <- c("phi.UV","phi.UW","phi.VW","psi")

  estimates<-c(u, v, w, params)
  return(estimates)
}
